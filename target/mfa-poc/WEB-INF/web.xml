        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    -->

    <!-- Context Parameters -->
    <context-param>
        <param-name>application.name</param-name>
        <param-value>MFA POC</param-value>
    </context-param>
    
    <context-param>
        <param-name>application.version</param-name>
        <param-value>1.0.0</param-value>
    </context-param>
    
    <context-param>
        <param-name>mfa.issuer</param-name>
        <param-value>Prolifics</param-value>
    </context-param>

